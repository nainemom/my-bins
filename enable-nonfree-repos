#!/usr/bin/env bash
set -e

if [ $EUID -ne 0 ]; then
  echo "[!] run as root."
  exit 1
fi

echo "[*] enabling contrib, non-free and non-free-firmware..."
for file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
  [[ -f "$file" ]] || continue
  sed -i -E 's/ main( non-free-firmware)?$/ main contrib non-free non-free-firmware/' "$file"
done

apt update
echo "[+] non-free repositories succesfully enabled."
