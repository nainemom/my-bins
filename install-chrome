#!/usr/bin/env bash
set -e

if [ $EUID -ne 0 ]; then
  echo "Run as root"
  exit 1
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "Fetching package..."
curl -#Lo $TMP/chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"

apt install -y $TMP/chrome.deb

echo "Done! $(google-chrome --version) installed!"
