#!/usr/bin/env bash
set -e

if [ $EUID -ne 0 ]; then
  echo "Run as root"
  exit 1
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "Fetching package..."
curl -#Lo $TMP/code.deb "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"

apt install -y $TMP/code.deb

echo "Done! Code $(code -v | head -1) installed!"
