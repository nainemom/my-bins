#!/usr/bin/env bash
set -e

if [ $EUID -ne 0 ]; then
  echo "Run as root"
  exit 1
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "Fetching latest release info..."
RELEASE="$(curl -s "https://slack.com/api/desktop.latestRelease?arch=x64&variant=deb")"
URL="$(echo "$RELEASE" | grep -o '"download_url":"[^"]*"' | cut -d'"' -f4 | tr -d '\\')"
VERSION="$(echo "$RELEASE" | grep -o '"version":"[^"]*"' | cut -d'"' -f4)"

echo "Fetching package..."
curl -#Lo $TMP/slack.deb "$URL"

apt install -y $TMP/slack.deb

echo "Done! Slack $VERSION installed!"
