#!/usr/bin/env bash
set -e

# MITM-DomainFronting setup helper (x86_64 only).
# Based on https://github.com/patterniha/MITM-DomainFronting
# Runs a local xray instance that intercepts TLS (MITM) and re-sends traffic
# with domain fronting, exposed as a SOCKS/HTTP proxy on the LAN so other
# devices can use it too.

CONFIG_URL="https://raw.githubusercontent.com/patterniha/MITM-DomainFronting/refs/heads/main/Xray-config/MITM-DomainFronting.json"
CONFIG_NAME="MITM-DomainFronting.json"

XRAY_BIN="$(command -v xray || echo /usr/local/bin/xray)"
STATE_DIR="/etc/mitm-domain-fronting"

CONFIG_FILE="$STATE_DIR/$CONFIG_NAME"
GEOIP_FILE="$STATE_DIR/geoip.dat"
GEOSITE_FILE="$STATE_DIR/geosite.dat"

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
NSSDB="$REAL_HOME/.pki/nssdb"
CERT_NICKNAME="MITM-DomainFronting"

IP_ADDRESSES=(127.0.0.1 $(hostname -I))

# Runtime state (used by cleanup)
XRAY_PID=""
PORT=""
CLEANED=0

# cleanup must be a function: it is the trap target and runs on any exit. The
# certificate is intentionally kept (persistent across runs).
cleanup() {
  [[ $CLEANED -eq 1 ]] && return
  CLEANED=1
  echo
  echo "[*] stopping xray..."
  [[ -n "$XRAY_PID" ]] && kill "$XRAY_PID" 2>/dev/null || true
  echo "[+] stopped."
}

if [[ $EUID -ne 0 ]]; then
  echo "[!] run as root"
  exit 1
fi

mkdir -p "$STATE_DIR"

echo "[*] checking dependencies..."

need_xray=0; [[ -x "$XRAY_BIN" ]] || need_xray=1
need_geo=0; { [[ -f "$GEOIP_FILE" && -f "$GEOSITE_FILE" ]]; } || need_geo=1
if [[ $need_xray -eq 1 || $need_geo -eq 1 ]]; then
  echo "    [!] xray not found"
  read -rp "    [?] download the latest xray release? (Y/n): " ans
  if [[ "$ans" == n || "$ans" == N ]]; then echo "[!] xray and geo data are required. aborting."; exit 1; fi
  tmp="$(mktemp -d)"
  echo "    [*] downloading xray..."
  wget -qO "$tmp/xray.zip" "https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip"
  if [[ $need_xray -eq 1 ]]; then
    unzip -o -q "$tmp/xray.zip" xray -d "$tmp"
    install -m 0755 "$tmp/xray" "$XRAY_BIN"
  fi
  if [[ $need_geo -eq 1 ]]; then
    unzip -o -q "$tmp/xray.zip" geoip.dat geosite.dat -d "$STATE_DIR"
  fi
  rm -rf "$tmp"
  echo "    [+] xray version $("$XRAY_BIN" version | head -n1 | awk '{print $2}') installed."
else
  echo "    [+] xray version $("$XRAY_BIN" version | head -n1 | awk '{print $2}') found."
fi

# jq
if ! command -v jq >/dev/null 2>&1; then
  echo "    [!] jq not found."
  read -rp "    [?] install jq via apt? (Y/n): " ans
  if [[ "$ans" == n || "$ans" == N ]]; then echo "[!] jq is required. aborting."; exit 1; fi
  echo "    [*] installing jq..."
  apt-get update
  apt-get install -y jq
  echo "    [+] jq version $(jq --version | awk -F '-' '{print $2}') installed."
else
  echo "    [+] jq version $(jq --version | awk -F '-' '{print $2}') found."
fi

# libnss3-tools
if ! command -v certutil >/dev/null 2>&1; then
  echo "    [!] libnss3-tools not found."
  read -rp "    [?] install libnss3-tools via apt? (Y/n): " ans
  if [[ "$ans" != n && "$ans" != N ]]; then
    apt-get update
    apt-get install -y libnss3-tools
  else
    echo "    [!] without it, we cant register the certificate. continuing anyway."
  fi
else
  echo "    [+] libnss3-tools found."
fi

if [[ -f "$CONFIG_FILE" ]]; then
  read -rp "    [?] mitm config already exists. update it? (y/N): " ans
  if [[ "$ans" == y || "$ans" == Y ]]; then
    wget -qO "$CONFIG_FILE" "$CONFIG_URL"
    echo "    [+] config downloaded."
  else
    echo "    [+] keeping existing config."
  fi
else
  echo "    [!] mitm config not found"
  read -rp "    [?] download config from upstream? (Y/n): " ans
  if [[ "$ans" == n || "$ans" == N ]]; then echo "[!] mitm config is required. aborting."; exit 1; fi
  wget -qO "$CONFIG_FILE" "$CONFIG_URL"
  echo "    [+] config downloaded."
fi

# Read the proxy port and certificate filenames straight from the config so
# they track whatever the upstream config uses instead of being hardcoded.
PORT="$(jq -r 'first(.inbounds[] | select(.protocol=="mixed") | .port)' "$CONFIG_FILE")"
CERT_REF="$(jq -r 'first(.. | objects | select(has("certificateFile")) | .certificateFile)' "$CONFIG_FILE")"
KEY_REF="$(jq -r 'first(.. | objects | select(has("keyFile")) | .keyFile)' "$CONFIG_FILE")"
CERT_BASE="$(basename "$CERT_REF" .crt)"
CERT_FILE="$STATE_DIR/$(basename "$CERT_REF")"
KEY_FILE="$STATE_DIR/$(basename "$KEY_REF")"

# Bind the mixed inbound to all interfaces (0.0.0.0) so any of the host's IPs
# work for other devices; the internal MITM inbounds stay on loopback (set in
# the jq rewrite below).
MIXED_IP="0.0.0.0"

if [[ ! -f "$CERT_FILE" || ! -f "$KEY_FILE" ]]; then
  echo "    [!] ca certificate not found."
  read -rp "    [?] generating new one? (Y/n): " ans
  if [[ "$ans" == n || "$ans" == N ]]; then echo "[!] ca certificate is required. aborting."; exit 1; fi
  echo "    [*] generating certificate..."
  ( cd "$STATE_DIR" && "$XRAY_BIN" tls cert -ca -file="$CERT_BASE" -name="$CERT_NICKNAME" )
  echo "    [+] ca certificate generated."
else
  echo "    [+] ca certificate found."
fi
chmod 600 "$KEY_FILE"
echo

# Rewrite the config: absolute cert paths (xray resolves relative paths against
# the binary dir), and bind the mixed inbound to MIXED_IP (others stay loopback).
tmp="$(mktemp)"
jq --arg crt "$CERT_FILE" --arg key "$KEY_FILE" --arg ip "$MIXED_IP" '
  (.. | objects | select(has("certificateFile"))) |= (.certificateFile=$crt | .keyFile=$key)
  | .inbounds |= map(if .protocol=="mixed"
                     then .listen=$ip | (.settings.ip=$ip)
                     else .listen="127.0.0.1" end)
' "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"

echo "[*] registering the ca certificate..."
runuser -u "$REAL_USER" -- mkdir -p "$NSSDB"
if ! command -v certutil >/dev/null 2>&1; then
  echo "    [+] skiping because there is no libnss3-tools."
elif runuser -u "$REAL_USER" -- certutil -d "sql:$NSSDB" -L -n "$CERT_NICKNAME" >/dev/null 2>&1; then
  echo "    [+] ca certificate is already registered for $REAL_USER."
else
  read -rp "    [?] whould u like to auto register ca certificate for $REAL_USER? (Y/n): " ans
  if [[ "$ans" == n || "$ans" == N ]]; then
    echo "    [+] skiping."
  else
    runuser -u "$REAL_USER" -- mkdir -p "$NSSDB"
    [[ -f "$NSSDB/cert9.db" ]] || runuser -u "$REAL_USER" -- certutil -d "sql:$NSSDB" -N --empty-password
    runuser -u "$REAL_USER" -- certutil -d "sql:$NSSDB" -D -n "$CERT_NICKNAME" 2>/dev/null || true
    runuser -u "$REAL_USER" -- certutil -d "sql:$NSSDB" -A -t "C,," -n "$CERT_NICKNAME" -i "$CERT_FILE"
    echo "    [+] ca certificate registered in nss trust store for $REAL_USER."
    echo "    [i] restart chrome/chromium for it to pick up the new ca certificate."
  fi
fi

echo
echo "[*] starting xray..."
trap cleanup EXIT INT TERM
# Run from the state dir so geo/asset files resolve. Background so cleanup fires.
( cd "$STATE_DIR" && XRAY_LOCATION_ASSET="$STATE_DIR" exec "$XRAY_BIN" run -c "$CONFIG_NAME" ) &
XRAY_PID=$!
echo "    [+] xray started."

echo "    [i] ca certificate: $CERT_FILE"
for ip in "${IP_ADDRESSES[@]}"; do
  echo "    [i] ip: ${ip}:${PORT}"
done
# echo "    [i] ip addresses: $IP_ADDRESSES"
# echo "    [i] port: $PORT"
echo 

wait "$XRAY_PID"
