#!/usr/bin/env bash

if ! command -v jq &> /dev/null; then
  echo "jq is not installed. aborting."
  exit 1
fi

hostname=$(hostname)
local_ipv4=$(hostname -I | awk '{print $1}')
local_ipv6=$(ip -6 addr show | grep 'inet6' | awk '{print $2}' | grep -v '^::1/' | head -n 1)
router_ip=$(ip route | grep default | awk '{print $3}')
dns_server=$(grep nameserver /etc/resolv.conf | cut -d ' ' -f 2)

printf "%-18s %s\n" "Hostname" ": $hostname"
printf "%-18s %s\n" "Local IPv4 Address" ": $local_ipv4"
printf "%-18s %s\n" "Local IPv6 Address" ": $local_ipv6"
printf "%-18s %s\n" "Router IP Address" ": $router_ip"
printf "%-18s %s\n" "DNS Server" ": $dns_server"

ip_result=$(curl -s https://ipinfo.io/json)
ip=$(echo "$ip_result" | jq -r '.ip')
hostname=$(echo "$ip_result" | jq -r '.hostname')
country=$(echo "$ip_result" | jq -r '.country')
city=$(echo "$ip_result" | jq -r '.city')
region=$(echo "$ip_result" | jq -r '.region')
timezone=$(echo "$ip_result" | jq -r '.timezone')
loc=$(echo "$ip_result" | jq -r '.loc')
org=$(echo "$ip_result" | jq -r '.org')
postal=$(echo "$ip_result" | jq -r '.postal')

printf "%-18s %s\n" "IP Address" ": $ip"
printf "%-18s %s\n" "Hostname" ": $hostname"
printf "%-18s %s\n" "Country" ": $country"
printf "%-18s %s\n" "City" ": $city"
printf "%-18s %s\n" "Region" ": $region"
printf "%-18s %s\n" "Timezone" ": $timezone"
printf "%-18s %s\n" "Coordinates" ": $loc"
printf "%-18s %s\n" "Org" ": $org"
printf "%-18s %s\n" "Postal Code" ": $postal"